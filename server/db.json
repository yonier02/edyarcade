      "code": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Geodesafío: Capitales del Mundo</title>\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Nunito', system-ui, sans-serif; }\n  body { background: #FFFDF7; color: #0F172A; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 16px; }\n  .card { max-width: 520px; width: 100%; background: #FFF; border: 3px solid #0F172A; border-radius: 12px; padding: 24px; box-shadow: 5px 5px 0px #0F172A; text-align: center; }\n  .header-tag { display: inline-block; background: #2EC4B6; color: #0F172A; font-weight: 800; font-size: 0.85rem; padding: 4px 12px; border: 2px solid #0F172A; border-radius: 20px; margin-bottom: 12px; }\n  .country-name { font-size: 1.8rem; font-weight: 800; color: #1E293B; margin-bottom: 8px; }\n  .hint { color: #64748B; font-size: 0.95rem; margin-bottom: 20px; }\n  .options-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 20px; }\n  .btn-opt { background: #F8FAFC; border: 2.5px solid #0F172A; border-radius: 8px; padding: 14px; font-size: 1rem; font-weight: 700; cursor: pointer; box-shadow: 3px 3px 0px #0F172A; transition: transform 0.1s; }\n  .btn-opt:hover { background: #FEF08A; transform: translateY(-2px); }\n  .btn-opt.correct { background: #86EFAC !important; }\n  .btn-opt.wrong { background: #FCA5A5 !important; }\n  .score-bar { display: flex; justify-content: space-around; font-family: monospace; font-size: 1rem; font-weight: 800; border-top: 2px solid #E2E8F0; padding-top: 14px; }\n</style>\n</head>\n<body>\n<div class=\"card\">\n  <div class=\"header-tag\">🌍 GEOGRAFÍA SECUNDARIA</div>\n  <div style=\"font-size:0.9rem; color:#64748B; margin-bottom:4px;\">¿Cuál es la capital oficial de?</div>\n  <div class=\"country-name\" id=\"countryText\">Australia</div>\n  <div class=\"hint\" id=\"hintText\">Pista: Continente Oceanía · No es Sídney ni Melbourne</div>\n  <div class=\"options-grid\" id=\"options\"></div>\n  <div class=\"score-bar\">\n    <span>Pregunta: <span id=\"qIdx\">1</span>/10</span>\n    <span>Puntos: <span id=\"score\">0</span></span>\n  </div>\n</div>\n\n<script>\nconst questions = [\n  { country: 'Australia', hint: 'Oceanía · Muy a menudo confundida con Sídney', correct: 'Canberra', opts: ['Sídney', 'Melbourne', 'Canberra', 'Brisbane'] },\n  { country: 'Canadá', hint: 'América del Norte · Segunda ciudad más grande de Ontario', correct: 'Ottawa', opts: ['Toronto', 'Vancouver', 'Montreal', 'Ottawa'] },\n  { country: 'Brasil', hint: 'América del Sur · Ciudad planificada construida en los años 50', correct: 'Brasilia', opts: ['Río de Janeiro', 'São Paulo', 'Brasilia', 'Salvador'] },\n  { country: 'Turquía', hint: 'Eurasia · Importante centro administrativo en Anatolia', correct: 'Ankara', opts: ['Estambul', 'Ankara', 'Esmirna', 'Antalya'] },\n  { country: 'Marruecos', hint: 'África · Ciudad costera con importante patrimonio imperial', correct: 'Rabat', opts: ['Casablanca', 'Marrakech', 'Rabat', 'Fez'] },\n  { country: 'Suiza', hint: 'Europa · Sede de las autoridades federales suizas', correct: 'Berna', opts: ['Zúrich', 'Ginebra', 'Berna', 'Basilea'] },\n  { country: 'Japón', hint: 'Asia Oriental · La mayor aglomeración urbana del mundo', correct: 'Tokio', opts: ['Kioto', 'Osaka', 'Tokio', 'Yokohama'] },\n  { country: 'Egipto', hint: 'África · Situada a orillas del legendario río Nilo', correct: 'El Cairo', opts: ['Alejandría', 'El Cairo', 'Guiza', 'Lúxor'] },\n  { country: 'Noruega', hint: 'Europa · En la cabecera del fiordo que lleva su nombre', correct: 'Oslo', opts: ['Bergen', 'Oslo', 'Trondheim', 'Stavanger'] },\n  { country: 'Nueva Zelanda', hint: 'Oceanía · La capital más austral del planeta', correct: 'Wellington', opts: ['Auckland', 'Christchurch', 'Wellington', 'Hamilton'] }\n];\nlet current = 0, score = 0, answered = false;\nfunction renderQuestion() {\n  answered = false;\n  const q = questions[current];\n  document.getElementById('countryText').textContent = q.country;\n  document.getElementById('hintText').textContent = 'Pista: ' + q.hint;\n  document.getElementById('qIdx').textContent = (current + 1);\n  const optsContainer = document.getElementById('options');\n  optsContainer.innerHTML = '';\n  const shuffled = [...q.opts].sort(() => Math.random() - 0.5);\n  shuffled.forEach(opt => {\n    const btn = document.createElement('button');\n    btn.className = 'btn-opt';\n    btn.textContent = opt;\n    btn.onclick = () => selectOption(opt, btn, q.correct);\n    optsContainer.appendChild(btn);\n  });\n}\nfunction selectOption(opt, btn, correct) {\n  if (answered) return;\n  answered = true;\n  const all = document.querySelectorAll('.btn-opt');\n  if (opt === correct) {\n    btn.classList.add('correct');\n    score += 10;\n    document.getElementById('score').textContent = score;\n  } else {\n    btn.classList.add('wrong');\n    all.forEach(b => { if (b.textContent === correct) b.classList.add('correct'); });\n  }\n  setTimeout(() => {\n    current++;\n    if (current < questions.length) {\n      renderQuestion();\n    } else {\n      alert(`🏁 ¡Completaste el Geodesafío! Puntuación: ${score}/${questions.length * 10} puntos.`);\n      current = 0; score = 0; document.getElementById('score').textContent = '0'; renderQuestion();\n    }\n  }, 1000);\n}\nrenderQuestion();\n</script>\n</body>\n</html>"
