      "playsCount": 142,
      "likesCount": 38,
      "code": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Parejas Químicas</title>\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Nunito', system-ui, sans-serif; }\n  body { background: #FFFDF7; color: #0F172A; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 16px; }\n  .header { text-align: center; margin-bottom: 16px; }\n  h1 { font-size: 1.5rem; color: #1E293B; font-weight: 800; }\n  .stats { display: flex; gap: 16px; margin-top: 8px; font-weight: bold; font-family: monospace; font-size: 1rem; }\n  .stat-badge { background: #E2E8F0; padding: 4px 12px; border-radius: 6px; border: 2px solid #0F172A; box-shadow: 2px 2px 0px #0F172A; }\n  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; max-width: 500px; width: 100%; perspective: 1000px; }\n  .card { aspect-ratio: 1; background: #2EC4B6; border: 3px solid #0F172A; border-radius: 10px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1rem; font-weight: 800; text-align: center; padding: 6px; box-shadow: 4px 4px 0px #0F172A; transition: transform 0.15s, background 0.2s; user-select: none; }\n  .card:hover { transform: translateY(-2px); }\n  .card.flipped { background: #FFF; }\n  .card.matched { background: #A7F3D0; cursor: default; border-color: #059669; box-shadow: 2px 2px 0px #059669; }\n  .btn { margin-top: 16px; background: #FF6B35; color: #FFF; font-weight: 800; padding: 10px 20px; border-radius: 8px; border: 3px solid #0F172A; box-shadow: 3px 3px 0px #0F172A; cursor: pointer; font-size: 0.95rem; }\n  .btn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0px #0F172A; }\n  .modal { position: fixed; inset: 0; background: rgba(15,23,42,0.7); display: flex; align-items: center; justify-content: center; z-index: 10; }\n  .modal-card { background: #FFFDF7; border: 3px solid #0F172A; box-shadow: 6px 6px 0px #0F172A; padding: 24px; border-radius: 12px; text-align: center; max-width: 360px; }\n</style>\n</head>\n<body>\n<div class=\"header\">\n  <h1>🧪 Parejas Químicas</h1>\n  <div class=\"stats\">\n    <div class=\"stat-badge\">⏱️ <span id=\"timer\">00:00</span></div>\n    <div class=\"stat-badge\">🎯 Intentos: <span id=\"moves\">0</span></div>\n    <div class=\"stat-badge\">✨ Aciertos: <span id=\"pairs\">0/8</span></div>\n  </div>\n</div>\n<div class=\"grid\" id=\"grid\"></div>\n<button class=\"btn\" id=\"restartBtn\">Reiniciar Partida</button>\n\n<script>\nconst pairsData = [\n  { id: 1, text: 'H₂O', match: 'Agua' },\n  { id: 1, text: 'Agua', match: 'H₂O' },\n  { id: 2, text: 'NaCl', match: 'Sal Común' },\n  { id: 2, text: 'Sal Común', match: 'NaCl' },\n  { id: 3, text: 'CO₂', match: 'Dióxido Carbono' },\n  { id: 3, text: 'Dióxido Carbono', match: 'CO₂' },\n  { id: 4, text: 'O₂', match: 'Oxígeno' },\n  { id: 4, text: 'Oxígeno', match: 'O₂' },\n  { id: 5, text: 'Fe', match: 'Hierro' },\n  { id: 5, text: 'Hierro', match: 'Fe' },\n  { id: 6, text: 'Au', match: 'Oro' },\n  { id: 6, text: 'Oro', match: 'Au' },\n  { id: 7, text: 'C₆H₁₂O₆', match: 'Glucosa' },\n  { id: 7, text: 'Glucosa', match: 'C₆H₁₂O₆' },\n  { id: 8, text: 'CH₄', match: 'Metano' },\n  { id: 8, text: 'Metano', match: 'CH₄' }\n];\nlet cards = [], flipped = [], matchedCount = 0, moves = 0, seconds = 0, timerInterval = null;\nfunction shuffle(arr) { return [...arr].sort(() => Math.random() - 0.5); }\nfunction formatTime(s) { const m = Math.floor(s/60); const sec = s%60; return `${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`; }\nfunction startTimer() {\n  if (timerInterval) clearInterval(timerInterval);\n  seconds = 0; document.getElementById('timer').textContent = '00:00';\n  timerInterval = setInterval(() => { seconds++; document.getElementById('timer').textContent = formatTime(seconds); }, 1000);\n}\nfunction init() {\n  cards = shuffle(pairsData);\n  flipped = []; matchedCount = 0; moves = 0;\n  document.getElementById('moves').textContent = '0';\n  document.getElementById('pairs').textContent = '0/8';\n  const grid = document.getElementById('grid'); grid.innerHTML = '';\n  cards.forEach((item, idx) => {\n    const el = document.createElement('div');\n    el.className = 'card';\n    el.dataset.index = idx;\n    el.dataset.id = item.id;\n    el.textContent = '?';\n    el.addEventListener('click', () => handleCardClick(el, item, idx));\n    grid.appendChild(el);\n  });\n  startTimer();\n}\nfunction handleCardClick(el, item, idx) {\n  if (flipped.length >= 2 || el.classList.contains('flipped') || el.classList.contains('matched')) return;\n  el.classList.add('flipped');\n  el.textContent = item.text;\n  flipped.push({ el, item, idx });\n  if (flipped.length === 2) {\n    moves++;\n    document.getElementById('moves').textContent = moves;\n    const [c1, c2] = flipped;\n    if (c1.item.id === c2.item.id) {\n      c1.el.classList.add('matched'); c2.el.classList.add('matched');\n      matchedCount++;\n      document.getElementById('pairs').textContent = `${matchedCount}/8`;\n      flipped = [];\n      if (matchedCount === 8) {\n        clearInterval(timerInterval);\n        setTimeout(() => alert(`🎉 ¡Excelente! Has completado el laboratorio químico en ${formatTime(seconds)} con ${moves} intentos.`), 250);\n      }\n    } else {\n      setTimeout(() => {\n        c1.el.classList.remove('flipped'); c1.el.textContent = '?';\n        c2.el.classList.remove('flipped'); c2.el.textContent = '?';\n        flipped = [];\n      }, 800);\n    }\n  }\n}\ndocument.getElementById('restartBtn').addEventListener('click', init);\ninit();\n</script>\n</body>\n</html>"
