      "code": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Master Quiz Ciencias</title>\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Nunito', system-ui, sans-serif; }\n  body { background: #FFFDF7; color: #0F172A; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 16px; }\n  .quiz-card { max-width: 580px; width: 100%; background: #FFF; border: 3px solid #0F172A; border-radius: 12px; padding: 24px; box-shadow: 6px 6px 0px #0F172A; }\n  .subject-pill { display: inline-block; background: #FEF08A; border: 2px solid #0F172A; border-radius: 6px; padding: 3px 10px; font-weight: 800; font-size: 0.8rem; margin-bottom: 12px; }\n  .q-title { font-size: 1.25rem; font-weight: 800; color: #1E293B; margin-bottom: 16px; line-height: 1.4; }\n  .opts { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; }\n  .opt-btn { text-align: left; background: #F8FAFC; border: 2.5px solid #0F172A; border-radius: 8px; padding: 12px 16px; font-size: 0.95rem; font-weight: 700; cursor: pointer; box-shadow: 3px 3px 0px #0F172A; transition: transform 0.1s; }\n  .opt-btn:hover { background: #E0F2FE; transform: translateX(3px); }\n  .opt-btn.correct { background: #86EFAC !important; border-color: #059669; }\n  .opt-btn.wrong { background: #FCA5A5 !important; border-color: #DC2626; }\n  .explanation { display: none; background: #EFF6FF; border: 2px solid #3B82F6; border-radius: 8px; padding: 12px; margin-bottom: 16px; font-size: 0.9rem; line-height: 1.4; color: #1E3A8A; }\n  .next-btn { display: none; width: 100%; background: #FF6B35; color: #FFF; border: 3px solid #0F172A; border-radius: 8px; padding: 12px; font-size: 1rem; font-weight: 800; cursor: pointer; box-shadow: 3px 3px 0px #0F172A; }\n  .footer-stats { display: flex; justify-content: space-between; margin-top: 16px; font-family: monospace; font-size: 0.95rem; font-weight: 700; border-top: 2px solid #E2E8F0; padding-top: 12px; }\n</style>\n</head>\n<body>\n<div class=\"quiz-card\">\n  <div class=\"subject-pill\" id=\"subjectPill\">BIOLOGÍA CELULAR</div>\n  <div class=\"q-title\" id=\"qTitle\">¿Qué orgánulo es considerado la 'central energética' de la célula eucariota?</div>\n  <div class=\"opts\" id=\"optsContainer\"></div>\n  <div class=\"explanation\" id=\"expBox\"></div>\n  <button class=\"next-btn\" id=\"nextBtn\">Siguiente Pregunta ➔</button>\n  <div class=\"footer-stats\">\n    <span>Progreso: <span id=\"qProg\">1</span>/5</span>\n    <span>Puntos: <span id=\"qScore\">0</span></span>\n  </div>\n</div>\n\n<script>\nconst quizData = [\n  {\n    subject: 'BIOLOGÍA',\n    q: '¿Qué orgánulo celular produce la mayor parte del ATP mediante respiración celular?',\n    opts: ['Ribosoma', 'Mitocondria', 'Aparato de Golgi', 'Lisosoma'],\n    ans: 1,\n    exp: 'Las mitocondrias son los orgánulos encargados de generar energía química utilizable (ATP) a través de la respiración celular aeróbica.'\n  },\n  {\n    subject: 'FÍSICA',\n    q: '¿A qué velocidad aproximada se propaga la luz en el vacío?',\n    opts: ['300.000 km/s', '150.000 km/s', '3.000 km/s', '300.000 km/h'],\n    ans: 0,\n    exp: 'La velocidad de la luz en el vacío (constante c) es de aproximadamente 299.792 km/s, universalmente redondeada a 300.000 km/s.'\n  },\n  {\n    subject: 'QUÍMICA',\n    q: '¿Por qué el hielo flota en el agua líquida?',\n    opts: ['Porque el hielo tiene mayor masa', 'Porque el agua sólida tiene menor densidad debido a su estructura de enlaces de hidrógeno', 'Por la presión atmosférica', 'Porque pierde átomos de oxígeno'],\n    ans: 1,\n    exp: 'Al congelarse, los enlaces de hidrógeno forman una red hexagonal espaciosa que hace que el hielo sea aproximadamente 9% menos denso que el agua líquida.'\n  },\n  {\n    subject: 'ASTRONOMÍA',\n    q: '¿Cuál es el planeta más grande de nuestro sistema solar?',\n    opts: ['Saturno', 'Neptuno', 'Júpiter', 'Urano'],\n    ans: 2,\n    exp: 'Júpiter es el planeta más masivo del sistema solar, con una masa más de dos veces superior a la de todos los demás planetas juntos.'\n  },\n  {\n    subject: 'FÍSICA',\n    q: 'Según la Primera Ley de Newton (Inercia), un cuerpo en reposo permanecerá en reposo a menos que:',\n    opts: ['Aumente su temperatura', 'Una fuerza neta externa actúe sobre él', 'Pase mucho tiempo', 'Se mueva en círculos'],\n    ans: 1,\n    exp: 'La ley de inercia establece que todo cuerpo preserva su estado de reposo o movimiento rectilíneo uniforme a menos que actúe una fuerza externa resultante.'\n  }\n];\nlet idx = 0, score = 0, answered = false;\nfunction loadQ() {\n  answered = false;\n  const item = quizData[idx];\n  document.getElementById('subjectPill').textContent = item.subject;\n  document.getElementById('qTitle').textContent = item.q;\n  document.getElementById('qProg').textContent = (idx + 1);\n  document.getElementById('expBox').style.display = 'none';\n  document.getElementById('nextBtn').style.display = 'none';\n  const container = document.getElementById('optsContainer');\n  container.innerHTML = '';\n  item.opts.forEach((text, i) => {\n    const btn = document.createElement('button');\n    btn.className = 'opt-btn';\n    btn.textContent = text;\n    btn.onclick = () => selectAns(i, btn);\n    container.appendChild(btn);\n  });\n}\nfunction selectAns(i, btn) {\n  if (answered) return;\n  answered = true;\n  const item = quizData[idx];\n  const btns = document.querySelectorAll('.opt-btn');\n  if (i === item.ans) {\n    btn.classList.add('correct');\n    score += 20;\n    document.getElementById('qScore').textContent = score;\n  } else {\n    btn.classList.add('wrong');\n    btns[item.ans].classList.add('correct');\n  }\n  const exp = document.getElementById('expBox');\n  exp.textContent = '💡 ' + item.exp;\n  exp.style.display = 'block';\n  document.getElementById('nextBtn').style.display = 'block';\n}\ndocument.getElementById('nextBtn').onclick = () => {\n  idx++;\n  if (idx < quizData.length) {\n    loadQ();\n  } else {\n    alert(`🎓 ¡Felicidades! Completaste el Master Quiz de Ciencias con ${score}/100 puntos.`);\n    idx = 0; score = 0; document.getElementById('qScore').textContent = '0'; loadQ();\n  }\n};\nloadQ();\n</script>\n</body>\n</html>"
