      "code": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Orden Sintáctico</title>\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Nunito', system-ui, sans-serif; }\n  body { background: #FFFDF7; color: #0F172A; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 16px; }\n  .container { max-width: 560px; width: 100%; background: #FFF; border: 3px solid #0F172A; border-radius: 12px; padding: 24px; box-shadow: 5px 5px 0px #0F172A; text-align: center; }\n  h2 { font-weight: 800; margin-bottom: 8px; }\n  .instruction { color: #64748B; font-size: 0.95rem; margin-bottom: 20px; }\n  .slot-zone { min-height: 80px; background: #F1F5F9; border: 2.5px dashed #0F172A; border-radius: 8px; padding: 12px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: center; margin-bottom: 20px; }\n  .bank-zone { min-height: 80px; background: #FEF3C7; border: 2px solid #0F172A; border-radius: 8px; padding: 12px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: center; margin-bottom: 20px; }\n  .word-pill { background: #FFF; border: 2px solid #0F172A; border-radius: 6px; padding: 8px 14px; font-weight: 700; cursor: pointer; box-shadow: 2px 2px 0px #0F172A; transition: transform 0.1s; user-select: none; }\n  .word-pill:hover { transform: translateY(-2px); }\n  .actions { display: flex; gap: 12px; justify-content: center; }\n  .btn { padding: 10px 20px; border-radius: 8px; border: 2.5px solid #0F172A; font-weight: 800; cursor: pointer; box-shadow: 3px 3px 0px #0F172A; }\n  .btn-check { background: #2EC4B6; color: #0F172A; }\n  .btn-reset { background: #E2E8F0; color: #0F172A; }\n  .status { margin-top: 14px; font-weight: 800; min-height: 24px; }\n</style>\n</head>\n<body>\n<div class=\"container\">\n  <h2>📝 Orden Sintáctico</h2>\n  <p class=\"instruction\">Haz clic en las palabras para construir la oración correcta en la zona superior.</p>\n  <div style=\"font-size:0.85rem; font-weight:700; color:#475569; margin-bottom:6px;\">Tu oración construida:</div>\n  <div class=\"slot-zone\" id=\"sentenceZone\"></div>\n  <div style=\"font-size:0.85rem; font-weight:700; color:#475569; margin-bottom:6px;\">Banco de palabras disponibles:</div>\n  <div class=\"bank-zone\" id=\"bankZone\"></div>\n  <div class=\"actions\">\n    <button class=\"btn btn-check\" id=\"checkBtn\">Verificar Oración</button>\n    <button class=\"btn btn-reset\" id=\"resetBtn\">Limpiar</button>\n  </div>\n  <div class=\"status\" id=\"statusMsg\"></div>\n</div>\n\n<script>\nconst puzzles = [\n  [\"La\", \"fotosíntesis\", \"convierte\", \"la\", \"luz\", \"solar\", \"en\", \"energía\", \"química\"],\n  [\"El\", \"pensamiento\", \"crítico\", \"permite\", \"analizar\", \"la\", \"información\", \"objetivamente\"],\n  [\"Los\", \"satélites\", \"artificiales\", \"orbitan\", \"la\", \"Tierra\", \"a\", \"gran\", \"velocidad\"],\n  [\"Las\", \"células\", \"eucariotas\", \"poseen\", \"un\", \"núcleo\", \"claramente\", \"definido\"]\n];\nlet currentIdx = 0, targetSentence = puzzles[0], currentWords = [];\nfunction initPuzzle() {\n  targetSentence = puzzles[currentIdx];\n  currentWords = [];\n  document.getElementById('statusMsg').textContent = '';\n  document.getElementById('sentenceZone').innerHTML = '';\n  const bank = document.getElementById('bankZone');\n  bank.innerHTML = '';\n  const shuffled = [...targetSentence].map((w, idx) => ({ word: w, id: idx })).sort(() => Math.random() - 0.5);\n  shuffled.forEach(item => {\n    const pill = document.createElement('div');\n    pill.className = 'word-pill';\n    pill.textContent = item.word;\n    pill.onclick = () => moveToSentence(item, pill);\n    bank.appendChild(pill);\n  });\n}\nfunction moveToSentence(item, el) {\n  el.remove();\n  currentWords.push(item);\n  const pill = document.createElement('div');\n  pill.className = 'word-pill';\n  pill.textContent = item.word;\n  pill.onclick = () => moveToBank(item, pill);\n  document.getElementById('sentenceZone').appendChild(pill);\n}\nfunction moveToBank(item, el) {\n  el.remove();\n  currentWords = currentWords.filter(w => w !== item);\n  const pill = document.createElement('div');\n  pill.className = 'word-pill';\n  pill.textContent = item.word;\n  pill.onclick = () => moveToSentence(item, pill);\n  document.getElementById('bankZone').appendChild(pill);\n}\ndocument.getElementById('checkBtn').addEventListener('click', () => {\n  const built = currentWords.map(w => w.word).join(' ');\n  const target = targetSentence.join(' ');\n  const msg = document.getElementById('statusMsg');\n  if (built === target) {\n    msg.textContent = '🎉 ¡Excelente sintaxis! Oración completamente correcta.';\n    msg.style.color = '#059669';\n    setTimeout(() => {\n      currentIdx = (currentIdx + 1) % puzzles.length;\n      initPuzzle();\n    }, 1500);\n  } else {\n    msg.textContent = '❌ El orden no es correcto todavía. ¡Revisa la estructura gramatical!';\n    msg.style.color = '#DC2626';\n  }\n});\ndocument.getElementById('resetBtn').addEventListener('click', initPuzzle);\ninitPuzzle();\n</script>\n</body>\n</html>"
