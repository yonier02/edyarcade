      "code": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Cálculo Relámpago</title>\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Nunito', system-ui, sans-serif; }\n  body { background: #FFFDF7; color: #0F172A; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 16px; }\n  .container { max-width: 480px; width: 100%; background: #FFF; border: 3px solid #0F172A; border-radius: 12px; padding: 24px; box-shadow: 5px 5px 0px #0F172A; text-align: center; }\n  .stats-bar { display: flex; justify-content: space-between; margin-bottom: 20px; font-family: monospace; font-size: 1.1rem; font-weight: bold; }\n  .badge { background: #FEF08A; border: 2px solid #0F172A; border-radius: 6px; padding: 4px 10px; }\n  .equation { font-size: 2.2rem; font-weight: 800; font-family: monospace; margin: 24px 0; letter-spacing: 2px; color: #1E293B; }\n  .options { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }\n  .opt-btn { background: #E0F2FE; border: 3px solid #0F172A; border-radius: 8px; font-size: 1.5rem; font-weight: 800; padding: 14px; cursor: pointer; box-shadow: 3px 3px 0px #0F172A; transition: transform 0.1s, background 0.15s; font-family: monospace; }\n  .opt-btn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0px #0F172A; }\n  .opt-btn.correct { background: #86EFAC !important; }\n  .opt-btn.wrong { background: #FCA5A5 !important; }\n  .streak-badge { color: #EA580C; font-weight: 800; font-size: 0.95rem; margin-top: 8px; }\n  .btn-start { background: #FF6B35; color: #FFF; border: 3px solid #0F172A; border-radius: 8px; padding: 12px 24px; font-size: 1.1rem; font-weight: 800; cursor: pointer; box-shadow: 3px 3px 0px #0F172A; }\n</style>\n</head>\n<body>\n<div class=\"container\">\n  <h2 style=\"margin-bottom:12px; font-weight:800;\">⚡ Cálculo Relámpago</h2>\n  <div id=\"gameView\" style=\"display:none;\">\n    <div class=\"stats-bar\">\n      <div class=\"badge\">⏱️ <span id=\"timer\">60</span>s</div>\n      <div class=\"badge\">🏆 <span id=\"score\">0</span> pts</div>\n      <div class=\"badge\">🔥 x<span id=\"multiplier\">1</span></div>\n    </div>\n    <div class=\"equation\" id=\"equation\">-7 + 15 = ?</div>\n    <div class=\"options\" id=\"optionsContainer\"></div>\n    <div class=\"streak-badge\" id=\"streakMsg\">Racha: 0 aciertos</div>\n  </div>\n  <div id=\"startView\">\n    <p style=\"margin-bottom: 20px; color: #475569;\">Tienes 60 segundos para resolver la mayor cantidad de cálculos de enteros y operaciones combinadas. ¡Mantén la racha para multiplicar puntos!</p>\n    <button class=\"btn-start\" id=\"startBtn\">¡Comenzar Reto!</button>\n  </div>\n</div>\n\n<script>\nlet score = 0, streak = 0, multiplier = 1, timeLeft = 60, currentAnswer = null, timerInterval = null, isPlaying = false;\nfunction generateProblem() {\n  const ops = ['+', '-', '*'];\n  const op = ops[Math.floor(Math.random() * ops.length)];\n  let n1, n2, ans, text;\n  if (op === '+') {\n    n1 = Math.floor(Math.random() * 40) - 15;\n    n2 = Math.floor(Math.random() * 40) - 10;\n    ans = n1 + n2;\n    text = `${n1 < 0 ? '('+n1+')' : n1} + ${n2 < 0 ? '('+n2+')' : n2}`;\n  } else if (op === '-') {\n    n1 = Math.floor(Math.random() * 40) - 10;\n    n2 = Math.floor(Math.random() * 30) - 10;\n    ans = n1 - n2;\n    text = `${n1 < 0 ? '('+n1+')' : n1} - ${n2 < 0 ? '('+n2+')' : n2}`;\n  } else {\n    n1 = Math.floor(Math.random() * 15) - 6;\n    n2 = Math.floor(Math.random() * 12) + 2;\n    ans = n1 * n2;\n    text = `${n1 < 0 ? '('+n1+')' : n1} × ${n2}`;\n  }\n  currentAnswer = ans;\n  document.getElementById('equation').textContent = text + ' = ?';\n  let options = new Set([ans]);\n  while (options.size < 4) {\n    let offset = (Math.floor(Math.random() * 9) + 1) * (Math.random() > 0.5 ? 1 : -1);\n    options.add(ans + offset);\n  }\n  const shuffled = Array.from(options).sort(() => Math.random() - 0.5);\n  const container = document.getElementById('optionsContainer');\n  container.innerHTML = '';\n  shuffled.forEach(val => {\n    const btn = document.createElement('button');\n    btn.className = 'opt-btn';\n    btn.textContent = val;\n    btn.onclick = () => checkAnswer(val, btn);\n    container.appendChild(btn);\n  });\n}\nfunction checkAnswer(chosen, btn) {\n  if (!isPlaying) return;\n  const allBtns = document.querySelectorAll('.opt-btn');\n  allBtns.forEach(b => b.disabled = true);\n  if (chosen === currentAnswer) {\n    btn.classList.add('correct');\n    streak++;\n    multiplier = Math.min(4, 1 + Math.floor(streak / 3));\n    score += 10 * multiplier;\n    document.getElementById('score').textContent = score;\n    document.getElementById('multiplier').textContent = multiplier;\n    document.getElementById('streakMsg').textContent = `🔥 Racha: ${streak} aciertos consecuitvos`;\n    setTimeout(() => { if (isPlaying) generateProblem(); }, 200);\n  } else {\n    btn.classList.add('wrong');\n    streak = 0; multiplier = 1;\n    document.getElementById('multiplier').textContent = multiplier;\n    document.getElementById('streakMsg').textContent = `❌ ¡Fallaste! Racha reiniciada`;\n    setTimeout(() => { if (isPlaying) generateProblem(); }, 400);\n  }\n}\nfunction startGame() {\n  score = 0; streak = 0; multiplier = 1; timeLeft = 60; isPlaying = true;\n  document.getElementById('startView').style.display = 'none';\n  document.getElementById('gameView').style.display = 'block';\n  document.getElementById('score').textContent = '0';\n  document.getElementById('multiplier').textContent = '1';\n  document.getElementById('timer').textContent = '60';\n  generateProblem();\n  if (timerInterval) clearInterval(timerInterval);\n  timerInterval = setInterval(() => {\n    timeLeft--;\n    document.getElementById('timer').textContent = timeLeft;\n    if (timeLeft <= 0) {\n      clearInterval(timerInterval);\n      isPlaying = false;\n      alert(`⏰ ¡Tiempo finalizado! Puntuación final: ${score} puntos.`);\n      document.getElementById('startView').style.display = 'block';\n      document.getElementById('gameView').style.display = 'none';\n    }\n  }, 1000);\n}\ndocument.getElementById('startBtn').addEventListener('click', startGame);\n</script>\n</body>\n</html>"
